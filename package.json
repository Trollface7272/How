{
  "name": "how2",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "dev": "tsx watch ./src/index.ts",
    "run-scripts": "tsx watch ./src/scripts.ts",
    "dotnet:build": "node scripts/dotnet-bootstrap.js && dotnet publish dotnet/howbot.PerformanceCalculator/howbot.PerformanceCalculator.csproj -c Release -o dotnet/howbot.PerformanceCalculator/publish"
  },
  "keywords": [],
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFiles": [
      "dotenv/config",
      "module-alias/register"
    ],
    "moduleNameMapper": {
      "^@src/(.*)$": "<rootDir>/src/$1",
      "^@class/(.*)$": "<rootDir>/src/class/$1",
      "^@osu/(.*)$": "<rootDir>/src/class/api/osu/$1",
      "^@database/(.*)$": "<rootDir>/src/class/database/$1",
      "^@commands/(.*)$": "<rootDir>/src/commands/$1"
    }
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/ejs": "^3.1.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/object-hash": "^3.0.6",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "canvas": "^3.2.3",
    "chart.js": "^4.5.1",
    "chartjs-adapter-moment": "^1.0.1",
    "chartjs-chart-matrix": "^3.0.5",
    "chartjs-node-canvas": "^5.0.0",
    "consola": "^3.4.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "edge-js": "^26.0.0",
    "ejs": "^6.0.1",
    "glob": "^13.0.6",
    "module-alias": "^2.3.4",
    "moment": "^2.30.1",
    "mongodb": "^7.5.0",
    "node-cache": "^5.1.2",
    "node-execution-context": "^3.1.0",
    "object-hash": "^3.0.0",
    "p-queue": "^9.3.1",
    "sharp": "^0.35.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.1"
  },
  "_moduleAliases": {
    "@src": "./src",
    "@class": "./src/class",
    "@osu/*": "./src/class/api/osu",
    "@database/*": "./src/class/database",
    "@commands/*": "./src/commands"
  }
